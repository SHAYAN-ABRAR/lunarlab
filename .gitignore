# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# LunarLab local state (experiment data stays on this machine). Anchored to the data home at the repository
# root: an unanchored "runs/" also hid the CartPole study's run records under reports/ (found 2026-10-28).
/data/
/runs/
reports/*
# ...except the JMLR-MLOSS evidence package (coverage, benchmarks, figures, artifact manifests)
!reports/jmlr/
reports/jmlr/coverage/html/
# ...and the dated Neurocomputing evidence (protocols, raw results, manifests; checkpoints stay local)
!reports/neurocomputing-2026-10-27/
reports/neurocomputing-2026-10-27/**/checkpoints/
!reports/neurocomputing-review-repairs-2026-10-28/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-demo/
frontend/test-results/
frontend/playwright-report/

# Editors / OS
.vscode/*
!.vscode/settings.json
.idea/
Thumbs.db
.DS_Store
.e2e-home/
.e2e-audit-home/

# Coverage data (reports are written to reports/jmlr/coverage/)
.coverage
.coverage.*
reports/neurocomputing-2026-10-27/workflow-comparison/fixtures/**/policy.zip
